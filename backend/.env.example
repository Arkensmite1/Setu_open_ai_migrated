# --- Database ---------------------------------------------------------
# MongoDB connection string (MongoDB Atlas free tier works fine).
MONGO_URL=mongodb://localhost:27017
DB_NAME=setu

# --- Auth ---------------------------------------------------------------
# Secret used to sign JWTs. On Render this is auto-generated by render.yaml;
# for local dev, set it to any long random string.
JWT_SECRET=change-me-to-a-long-random-string

# --- OpenAI (Setu AI assistant, alert translation, image-based reports) --
# Required — AI-dependent endpoints will error without a valid key.
OPENAI_API_KEY=sk-your-openai-api-key
# Optional — both default to gpt-4o-mini if omitted.
OPENAI_MODEL=gpt-4o-mini
OPENAI_VISION_MODEL=gpt-4o-mini

# --- CORS -----------------------------------------------------------------
# Comma-separated list of allowed frontend origins, e.g. your Vercel URL.
CORS_ORIGINS=http://localhost:3000
